# ── Database (默认 SQLite，无需额外安装) ──
DATABASE_URL=sqlite+aiosqlite:///./data/knowbase.db

# ── JWT 密钥 (可随机生成) ──
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256

# ── LLM API Key (至少填一个) ──
# 智谱AI（推荐，GLM-4-Flash 免费/便宜）→ https://open.bigmodel.cn/
ZHIPU_API_KEY=
# DeepSeek → https://platform.deepseek.com/
DEEPSEEK_BASE_URL=https://api.deepseek.com
# OpenAI → https://platform.openai.com/
OPENAI_API_KEY=

# ── 上传 ──
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./data/uploads

# ── CORS ──
CORS_ORIGINS=["http://localhost:3000","tauri://localhost","http://tauri.localhost","https://tauri.localhost"]

# ── 以下为生产环境可选配置 (单机桌面版无需填写) ──
REDIS_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
