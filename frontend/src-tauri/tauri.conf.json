{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KnowBase",
  "version": "0.1.0",
  "identifier": "com.hbg129.knowbase",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "KnowBase",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "HBG129",
    "homepage": "https://github.com/HBG129/knowbase",
    "copyright": "Copyright 2026 HBG129",
    "category": "Productivity",
    "shortDescription": "Desktop AI knowledge base assistant",
    "longDescription": "KnowBase is a desktop AI knowledge base assistant for local document upload, retrieval augmented generation, cited answers, and private knowledge workflows.",
    "resources": {
      "../../backend/dist/KnowBaseBackend.exe": "KnowBaseBackend.exe"
    },
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "./WebView2.FixedVersionRuntime.x64"
      },
      "nsis": {
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  }
}
