{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KnowBase",
  "version": "0.1.0",
  "identifier": "com.hbg129.knowbase",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.next"
  },
  "app": {
    "windows": [
      {
        "title": "KnowBase",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../backend/dist/KnowBaseBackend.exe": "KnowBaseBackend.exe"
    },
    "icon": []
  }
}
